{
  "repo": "ARMOR-NODE-SOLAR",
  "ecosystem": "armor",
  "tagline": "Reads the inverter and the batteries of a solar installation and says what they say, never writing to the inverter, and to a battery only behind three locks.",
  "description": "The firmware of ARMOR-NODE-SOLAR talks to Voltronic inverters, Pylontech batteries and ANT-BMS batteries through ten serial ports, turns what they say into the messages ARMOR-COMMON accepts and serves a web panel. It has never run on a board and no inverter or battery has been connected.",
  "columns": [
    "WHAT IS CONNECTED",
    "THIS FIRMWARE",
    "WHO IT TALKS TO"
  ],
